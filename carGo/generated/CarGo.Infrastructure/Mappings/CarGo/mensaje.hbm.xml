<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CarGo.Domain"
                   namespace="CarGo.Domain.Entities">
  <class name="Mensaje" table="Mensaje">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Contenido" type="String">
      <column name="contenido" not-null="true"/>
    </property>
    <property name="FechaHora" type="DateTime">
      <column name="fechaHora" not-null="true"/>
    </property>
    <many-to-one name="Viaje" class="Viaje">
      <column name="FK_Viaje_viaje" not-null="true"/>
    </many-to-one>
    <many-to-one name="Remitente" class="Usuario">
      <column name="FK_Usuario_remitente" not-null="true"/>
    </many-to-one>
  </class>
  <query name="MensajeReadAllHQL">from Mensaje</query>
</hibernate-mapping>
