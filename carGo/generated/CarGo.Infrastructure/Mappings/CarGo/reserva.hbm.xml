<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CarGo.Domain"
                   namespace="CarGo.Domain.Entities">
  <class name="Reserva" table="Reserva">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="NumPlazasReservadas" type="Int32">
      <column name="numPlazasReservadas" not-null="true"/>
    </property>
    <property name="Estado" type="CarGo.Domain.Enums.EstadoReserva, CarGo.Domain">
      <column name="estado" not-null="true"/>
    </property>
    <property name="FechaSolicitud" type="DateTime">
      <column name="fechaSolicitud" not-null="true"/>
    </property>
    <many-to-one name="Viaje" class="Viaje">
      <column name="FK_Viaje_viaje" not-null="true"/>
    </many-to-one>
    <many-to-one name="Pasajero" class="Usuario">
      <column name="FK_Usuario_pasajero" not-null="true"/>
    </many-to-one>
    <many-to-one name="Pago" class="Pago">
      <column name="FK_Pago_pago"/>
    </many-to-one>
  </class>
  <query name="ReservaReadAllHQL">from Reserva</query>
</hibernate-mapping>
