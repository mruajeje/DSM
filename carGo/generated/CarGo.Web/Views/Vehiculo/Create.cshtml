@model CarGo.Web.ViewModels.VehiculoViewModel

@{
    ViewData["Title"] = "Crear vehículo";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Crear</span>
                <h1 class="h3 mb-1">Vehículo</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="MarcaModelo" class="form-label"></label>
                        <input asp-for="MarcaModelo" class="form-control" placeholder="Ej. Seat Ibiza 1.0 TSI" />
                        <span asp-validation-for="MarcaModelo" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Matricula" class="form-label"></label>
                        <input asp-for="Matricula" class="form-control text-uppercase" placeholder="Ej. 1234ABC" />
                        <span asp-validation-for="Matricula" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="InformacionAdicional" class="form-label"></label>
                        <input asp-for="InformacionAdicional" class="form-control" placeholder="Color, maletero grande, aire acondicionado..." />
                        <span asp-validation-for="InformacionAdicional" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PropietarioId" class="form-label"></label>
                        <select asp-for="PropietarioId" asp-items="Model.PropietarioOptions" class="form-select">
                            <option value="">Selecciona un propietario...</option>
                        </select>
                        <span asp-validation-for="PropietarioId" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}