@* HARIA-WEB GENERATED sha256:17d5a09cbc0144c309cb080ee700285d758481d980d61e92109235954abbed3a *@
@model IEnumerable<CarGo.Web.ViewModels.ViajeViewModel>

@{
    ViewData["Title"] = "Viaje";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-4">
        <div>
            <h1 class="h3 mb-1">Viaje</h1>
            <p class="text-body-secondary mb-0">Consulta y gestiona los registros disponibles.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Crear</a>
    </div>
    <div class="card-body p-0">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.Id)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.OrigenCiudad)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.OrigenDireccion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.OrigenLatitud)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.OrigenLongitud)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.DestinoCiudad)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.DestinoDireccion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.DestinoLatitud)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.DestinoLongitud)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.FechaHoraSalida)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.NumPlazasDisponibles)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PrecioMoneda)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PrecioCantidad)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PermiteMascotas)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.PermiteEquipaje)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Observaciones)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Estado)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.LatitudActual)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.LongitudActual)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.FechaUltimaPosicion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.ConductorLabel)</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@Html.DisplayFor(modelItem => item.OrigenCiudad)</td>
                            <td>@Html.DisplayFor(modelItem => item.OrigenDireccion)</td>
                            <td>@Html.DisplayFor(modelItem => item.OrigenLatitud)</td>
                            <td>@Html.DisplayFor(modelItem => item.OrigenLongitud)</td>
                            <td>@Html.DisplayFor(modelItem => item.DestinoCiudad)</td>
                            <td>@Html.DisplayFor(modelItem => item.DestinoDireccion)</td>
                            <td>@Html.DisplayFor(modelItem => item.DestinoLatitud)</td>
                            <td>@Html.DisplayFor(modelItem => item.DestinoLongitud)</td>
                            <td>@Html.DisplayFor(modelItem => item.FechaHoraSalida)</td>
                            <td>@Html.DisplayFor(modelItem => item.NumPlazasDisponibles)</td>
                            <td>@Html.DisplayFor(modelItem => item.PrecioMoneda)</td>
                            <td>@Html.DisplayFor(modelItem => item.PrecioCantidad)</td>
                            <td>@Html.DisplayFor(modelItem => item.PermiteMascotas)</td>
                            <td>@Html.DisplayFor(modelItem => item.PermiteEquipaje)</td>
                            <td>@Html.DisplayFor(modelItem => item.Observaciones)</td>
                            <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                            <td>@Html.DisplayFor(modelItem => item.LatitudActual)</td>
                            <td>@Html.DisplayFor(modelItem => item.LongitudActual)</td>
                            <td>@Html.DisplayFor(modelItem => item.FechaUltimaPosicion)</td>
                            <td>@Html.DisplayFor(modelItem => item.ConductorLabel)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center p-5">
            <h2 class="h5">Todavía no hay registros</h2>
            <p class="text-body-secondary">Crea el primer registro para comenzar.</p>
            <a asp-action="Create" class="btn btn-primary">Crear</a>
        </div>
    }
    </div>
</div>
