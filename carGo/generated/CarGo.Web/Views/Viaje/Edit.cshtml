@* HARIA-WEB GENERATED sha256:7b671eeda5d69bdcc4c43ff06b9f51f18427919cf1a8efacef7dcbdb77c5dcd2 *@
@model CarGo.Web.ViewModels.ViajeViewModel

@{
    ViewData["Title"] = "Editar";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Editar</span>
                <h1 class="h3 mb-1">Viaje</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="OrigenCiudad" class="form-label"></label>
            <input asp-for="OrigenCiudad" class="form-control" />
            <span asp-validation-for="OrigenCiudad" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="OrigenDireccion" class="form-label"></label>
            <input asp-for="OrigenDireccion" class="form-control" />
            <span asp-validation-for="OrigenDireccion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="OrigenLatitud" class="form-label"></label>
            <input asp-for="OrigenLatitud" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="OrigenLatitud" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="OrigenLongitud" class="form-label"></label>
            <input asp-for="OrigenLongitud" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="OrigenLongitud" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DestinoCiudad" class="form-label"></label>
            <input asp-for="DestinoCiudad" class="form-control" />
            <span asp-validation-for="DestinoCiudad" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DestinoDireccion" class="form-label"></label>
            <input asp-for="DestinoDireccion" class="form-control" />
            <span asp-validation-for="DestinoDireccion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DestinoLatitud" class="form-label"></label>
            <input asp-for="DestinoLatitud" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="DestinoLatitud" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DestinoLongitud" class="form-label"></label>
            <input asp-for="DestinoLongitud" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="DestinoLongitud" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FechaHoraSalida" class="form-label"></label>
            <input asp-for="FechaHoraSalida" class="form-control" />
            <span asp-validation-for="FechaHoraSalida" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NumPlazasDisponibles" class="form-label"></label>
            <input asp-for="NumPlazasDisponibles" class="form-control" />
            <span asp-validation-for="NumPlazasDisponibles" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PrecioMoneda" class="form-label"></label>
            <select asp-for="PrecioMoneda" asp-items="Html.GetEnumSelectList<CarGo.Domain.Enums.EnumMoneda>()" class="form-select"></select>
            <span asp-validation-for="PrecioMoneda" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PrecioCantidad" class="form-label"></label>
            <input asp-for="PrecioCantidad" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="PrecioCantidad" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="PermiteMascotas" class="form-check-input" />
            <label asp-for="PermiteMascotas" class="form-check-label"></label>
            <span asp-validation-for="PermiteMascotas" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="PermiteEquipaje" class="form-check-input" />
            <label asp-for="PermiteEquipaje" class="form-check-label"></label>
            <span asp-validation-for="PermiteEquipaje" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<CarGo.Domain.Enums.EstadoViaje>()" class="form-select"></select>
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConductorId" class="form-label"></label>
            <select asp-for="ConductorId" asp-items="Model.ConductorOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="ConductorId" class="text-danger"></span>
        </div>
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/haria-numbers.js" asp-append-version="true"></script>

}
