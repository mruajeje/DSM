<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d6efd" />
    <title>@ViewData["Title"] · CarGo.Web</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarGo.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-body-tertiary cargo-has-dock">
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Activo(params string[] controladores) =>
        controladores.Contains(ctrl, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esConductor = User.IsInRole("Conductor");
    var esAdmin = User.IsInRole("Admin");
}
    <header class="cargo-topbar border-bottom bg-body">
        <div class="container d-flex align-items-center justify-content-between py-2">
            <a class="cargo-brand text-decoration-none" asp-controller="Home" asp-action="Index">CarGo</a>
            <div class="d-flex align-items-center gap-2">
                @if (autenticado)
                {
                    <a class="cargo-icon-btn @Activo("Notificacion")" asp-controller="Notificacion" asp-action="Index" aria-label="Notificaciones" title="Notificaciones"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 17V11a6 6 0 1 1 12 0v6l1.5 2h-15z"/><path d="M10 21h4"/></svg></a>
                }
                else
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Usuario" asp-action="Register">Crear cuenta</a>
                    <a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                }
            </div>
        </div>
    </header>

    <main class="container flex-grow-1 py-4 py-lg-5">
        <partial name="_Mensajes" />

        @RenderBody()
    </main>

    <footer class="border-top bg-body py-3 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 small text-body-secondary">
            <span>&copy; @DateTime.Now.Year CarGo</span>
            <a asp-controller="Home" asp-action="Privacy" class="link-secondary">Privacidad</a>
        </div>
    </footer>

    @if (autenticado)
    {
        <nav class="cargo-dock" aria-label="Navegación principal">
            <a class="cargo-dock-item @Activo("Home")" asp-controller="Home" asp-action="Index">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg><span>Inicio</span>
            </a>

            <a class="cargo-dock-item @Activo("Viaje")" asp-controller="Viaje" asp-action="Index">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span>Viajes</span>
            </a>

            <div class="cargo-dock-slot">
                <a class="cargo-dock-plus" asp-controller="Viaje" asp-action="Create" aria-label="Crear viaje" title="Crear viaje">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
                </a>
            </div>

            <a class="cargo-dock-item @Activo("Mensaje")" asp-controller="Mensaje" asp-action="Index">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg><span>Mensajes</span>
            </a>

            <div class="dropup cargo-dock-slot">
                <button type="button" class="cargo-dock-item @Activo("Usuario", "Vehiculo", "Reserva", "Pago", "Resena", "Notificacion")" data-bs-toggle="dropdown" data-bs-offset="0,14" aria-expanded="false">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg><span>Perfil</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end cargo-dock-menu">
                    <li><a class="dropdown-item" asp-controller="Usuario" asp-action="Details" asp-route-id="@User.Identity!.Name">Mi perfil</a></li>
                    <li><a class="dropdown-item" asp-controller="Vehiculo" asp-action="Index">Vehículos</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><h6 class="dropdown-header">Reservas</h6></li>
                    <li><a class="dropdown-item" asp-controller="Reserva" asp-action="Index">Listado</a></li>
                    <li><a class="dropdown-item" asp-controller="Reserva" asp-action="Buscar">Buscar reservas</a></li>
                    @if (esConductor || esAdmin)
                    {
                        <li><a class="dropdown-item" asp-controller="Reserva" asp-action="Gestionar">Gestionar reservas</a></li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li><h6 class="dropdown-header">Pagos</h6></li>
                    <li><a class="dropdown-item" asp-controller="Pago" asp-action="Index">Listado</a></li>
                    <li><a class="dropdown-item" asp-controller="Pago" asp-action="Gestionar">Gestionar pagos</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-controller="Resena" asp-action="Index">Reseñas</a></li>
                    <li><a class="dropdown-item" asp-controller="Notificacion" asp-action="Index">Notificaciones</a></li>
                    @if (esAdmin)
                    {
                        <li><a class="dropdown-item" asp-controller="Usuario" asp-action="Index">Usuarios</a></li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="dropdown-item text-danger">Cerrar sesión</button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>