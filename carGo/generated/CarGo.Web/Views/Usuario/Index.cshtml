@model IEnumerable<CarGo.Web.ViewModels.UsuarioViewModel>

@{
    ViewData["Title"] = "Usuario";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-4">
        <div>
            <h1 class="h3 mb-1">Usuario</h1>
            <p class="text-body-secondary mb-0">Consulta y gestiona los registros disponibles.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Crear</a>
    </div>
    <div class="card-body border-bottom p-4">
        <form asp-action="Buscar" method="get" class="row g-2 align-items-end">
            <div class="col-sm-5">
                <label for="email" class="form-label">Email</label>
                <input id="email" name="email" value="@ViewData["Email"]" class="form-control" />
            </div>
            <div class="col-sm-4">
                <label for="dni" class="form-label">DNI</label>
                <input id="dni" name="dni" value="@ViewData["Dni"]" class="form-control" />
            </div>
            <div class="col-sm-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.Id)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.NombreCompleto)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Email)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Telefono)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Dni)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.EsAdmin)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.EstadoVerificacion)</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@Html.DisplayFor(modelItem => item.NombreCompleto)</td>
                            <td>@Html.DisplayFor(modelItem => item.Email)</td>
                            <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                            <td>@Html.DisplayFor(modelItem => item.Dni)</td>
                            <td>@Html.DisplayFor(modelItem => item.EsAdmin)</td>
                            <td>@Html.DisplayFor(modelItem => item.EstadoVerificacion)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center p-5">
            <h2 class="h5">No hay registros</h2>
            <p class="text-body-secondary">No se ha encontrado ningún usuario con esos datos.</p>
            <a asp-action="Create" class="btn btn-primary">Crear</a>
        </div>
    }
    </div>
</div>