@model CarGo.Web.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = "Editar";
    var esAdmin = User.IsInRole("Admin");
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Editar</span>
                <h1 class="h3 mb-1">Usuario</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" value="" autocomplete="new-password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="form-text">Déjalo vacío para conservar la contraseña actual.</div>
        </div>
        <div class="mb-3">
            <label asp-for="NombreCompleto" class="form-label"></label>
            <input asp-for="NombreCompleto" class="form-control" />
            <span asp-validation-for="NombreCompleto" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        @if (esAdmin)
        {
            <div class="form-check mb-3">
                <input asp-for="EsAdmin" class="form-check-input" />
                <label asp-for="EsAdmin" class="form-check-label"></label>
                <span asp-validation-for="EsAdmin" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EstadoVerificacion" class="form-label"></label>
                <select asp-for="EstadoVerificacion" asp-items="Html.GetEnumSelectList<CarGo.Domain.Enums.EstadoVerificacion>()" class="form-select"></select>
                <span asp-validation-for="EstadoVerificacion" class="text-danger"></span>
            </div>
        }
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    @if (esAdmin)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}