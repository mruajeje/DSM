@model CarGo.Web.ViewModels.PagoViewModel

@{
    ViewData["Title"] = "Crear";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Crear</span>
                <h1 class="h3 mb-1">Pago</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
        <div class="mb-3">
            <label asp-for="MontoMoneda" class="form-label"></label>
            <select asp-for="MontoMoneda" asp-items="Html.GetEnumSelectList<CarGo.Domain.Enums.EnumMoneda>()" class="form-select"></select>
            <span asp-validation-for="MontoMoneda" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MontoCantidad" class="form-label"></label>
            <input asp-for="MontoCantidad" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="MontoCantidad" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FechaPago" class="form-label"></label>
            <input asp-for="FechaPago" class="form-control" />
            <span asp-validation-for="FechaPago" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<CarGo.Domain.Enums.EstadoPago>()" class="form-select"></select>
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ReservaId" class="form-label"></label>
            <select asp-for="ReservaId" asp-items="Model.ReservaOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="ReservaId" class="text-danger"></span>
        </div>
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/haria-numbers.js" asp-append-version="true"></script>

}
