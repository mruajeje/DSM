@model IEnumerable<CarGo.Web.ViewModels.ReservaViewModel>
@using CarGo.Domain.Enums

@{
    ViewData["Title"] = "Gestionar reservas";
    var soloMias = ViewData["Mias"] as bool? ?? false;

    string Insignia(EstadoReserva estado) => estado switch
    {
        EstadoReserva.Pendiente => "text-bg-warning",
        EstadoReserva.Aceptada => "text-bg-success",
        EstadoReserva.Rechazada => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-4">
        <div>
            <h1 class="h3 mb-1">Gestionar reservas</h1>
            <p class="text-body-secondary mb-0">Acepta, rechaza o cancela reservas. Solo puedes hacerlo si tienes permiso sobre el viaje.</p>
        </div>
        <div class="d-flex gap-2">
            @if (soloMias)
            {
                <a asp-action="Gestionar" class="btn btn-outline-primary">Ver todas</a>
            }
            else
            {
                <a asp-action="Gestionar" asp-route-mias="true" class="btn btn-outline-primary">Solo mis reservas</a>
            }
            <a asp-action="Buscar" class="btn btn-outline-secondary">Buscar</a>
            <a asp-action="Create" class="btn btn-primary">Nueva reserva</a>
        </div>
    </div>
    <div class="card-body p-0">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Viaje</th>
                        <th scope="col">Pasajero</th>
                        <th scope="col">Plazas</th>
                        <th scope="col">Solicitada</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Id</td>
                        <td>@r.ViajeLabel</td>
                        <td>@r.PasajeroLabel</td>
                        <td>@r.NumPlazasReservadas</td>
                        <td>@r.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @Insignia(r.Estado)">@r.Estado</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            @if (r.Estado == EstadoReserva.Pendiente)
                            {
                                <form asp-action="AceptarPasajero" method="post" class="d-inline">
                                    <input type="hidden" name="p_oid" value="@r.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Aceptar</button>
                                </form>
                                <form asp-action="RechazarPasajero" method="post" class="d-inline">
                                    <input type="hidden" name="p_oid" value="@r.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Rechazar</button>
                                </form>
                            }
                            @if (r.Estado == EstadoReserva.Pendiente || r.Estado == EstadoReserva.Aceptada)
                            {
                                <form asp-action="CancelarReserva" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Seguro que quieres cancelar esta reserva?');">
                                    <input type="hidden" name="p_oid" value="@r.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Cancelar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-body-secondary p-4 mb-0">No hay reservas que mostrar.</p>
    }
    </div>
</div>
