<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CarGoGen.Domain"
                   namespace="CarGoGen.Domain.Entities">
  <class name="Usuario" table="Usuario">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Password" type="String">
      <column name="password" not-null="true"/>
    </property>
    <property name="NombreCompleto" type="String">
      <column name="nombreCompleto" not-null="true"/>
    </property>
    <property name="Email" type="String">
      <column name="email" not-null="true"/>
    </property>
    <property name="Telefono" type="String">
      <column name="telefono"/>
    </property>
    <property name="Dni" type="String">
      <column name="dni"/>
    </property>
    <property name="EsAdmin" type="Boolean">
      <column name="esAdmin" not-null="true"/>
    </property>
    <property name="EstadoVerificacion" type="CarGoGen.Domain.Enums.EstadoVerificacion, CarGoGen.Domain">
      <column name="estadoVerificacion" not-null="true"/>
    </property>
    <bag name="Vehiculos">
      <key>
        <column name="FK_Usuario_vehiculos"/>
      </key>
      <one-to-many class="Vehiculo"/>
    </bag>
    <bag name="Viajes">
      <key>
        <column name="FK_Usuario_viajes"/>
      </key>
      <one-to-many class="Viaje"/>
    </bag>
    <bag name="Reservas">
      <key>
        <column name="FK_Usuario_reservas"/>
      </key>
      <one-to-many class="Reserva"/>
    </bag>
    <bag name="MensajesEnviados">
      <key>
        <column name="FK_Usuario_mensajesEnviados"/>
      </key>
      <one-to-many class="Mensaje"/>
    </bag>
    <bag name="ResenasEscritas">
      <key>
        <column name="FK_Usuario_resenasEscritas"/>
      </key>
      <one-to-many class="Resena"/>
    </bag>
    <bag name="Notificaciones">
      <key>
        <column name="FK_Usuario_notificaciones"/>
      </key>
      <one-to-many class="Notificacion"/>
    </bag>
  </class>
  <query name="UsuarioReadAllHQL">from Usuario</query>
</hibernate-mapping>
