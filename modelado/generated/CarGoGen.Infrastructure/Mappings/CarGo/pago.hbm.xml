<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CarGoGen.Domain"
                   namespace="CarGoGen.Domain.Entities">
  <class name="Pago" table="Pago">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Importe" type="Single">
      <column name="importe" not-null="true"/>
    </property>
    <property name="FechaPago" type="DateTime">
      <column name="fechaPago" not-null="true"/>
    </property>
    <property name="Completado" type="Boolean">
      <column name="completado" not-null="true"/>
    </property>
    
    <many-to-one name="Reserva" class="Reserva" unique="true">
      <column name="FK_Reserva_pago" not-null="true"/>
    </many-to-one>
  </class>
  <query name="PagoReadAllHQL">from Pago</query>
</hibernate-mapping>