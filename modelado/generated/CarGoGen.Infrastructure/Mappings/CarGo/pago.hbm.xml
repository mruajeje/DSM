<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CarGoGen.Domain"
                   namespace="CarGoGen.Domain.Entities">
  <class name="Pago" table="Pago">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="FechaPago" type="DateTime">
      <column name="fechaPago" not-null="true"/>
    </property>
    <property name="Estado" type="CarGoGen.Domain.Enums.EstadoPago, CarGoGen.Domain">
      <column name="estado" not-null="true"/>
    </property>
    <component name="Monto" class="CarGoGen.Domain.ValueObjects.Dinero, CarGoGen.Domain">
      <property name="Moneda" type="CarGoGen.Domain.Enums.EnumMoneda, CarGoGen.Domain">
        <column name="monto_moneda" not-null="true"/>
      </property>
      <property name="Cantidad" type="Double">
        <column name="monto_cantidad" not-null="true"/>
      </property>
      <property name="IdTransaccionPasarela" type="String">
        <column name="idTransaccionPasarela" not-null="false" />
      </property>
    </component>
    <many-to-one name="Reserva" class="Reserva">
      <column name="FK_Reserva_reserva" not-null="true"/>
    </many-to-one>
  </class>
  <query name="PagoReadAllHQL">from Pago</query>
</hibernate-mapping>
