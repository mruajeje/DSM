ConceptualModel CarGo {

    Enumeration EnumMoneda {
        (EUR, 1), (USD, 2)
    };

    Enumeration EstadoViaje {
        (Publicado, 1), (EnCurso, 2), (Finalizado, 3), (Cancelado, 4)
    };

    Enumeration EstadoReserva {
        (Pendiente, 1), (Aceptada, 2), (Rechazada, 3), (Cancelada, 4)
    };

    Enumeration EstadoPago {
        (Pendiente, 1), (Completado, 2), (Reembolsado, 3)
    };

    Enumeration EstadoVerificacion {
        (Pendiente, 1), (Verificado, 2), (Rechazado, 3)
    };

    Class Dinero <ValueObject> {
        attributes {
            private moneda : EnumMoneda (1, 1);
            private cantidad : Double (1, 1);
        }
    };

    Class Ubicacion <ValueObject> {
        attributes {
            private ciudad : String (1, 1);
            private direccion : String (1, 1);
            private latitud : Double (1, 1);
            private longitud : Double (1, 1);
        }
    };

    Class Usuario <User> {
        attributes {
            private oid isToken id : Autogenerated (1, 1);
            private password : Password (1, 1);
            private nombreCompleto : String (1, 1);
            private email : String (1, 1);
            private telefono : String (0, 1);
            private dni : String (0, 1);
            private esAdmin : Boolean (1, 1);
            private estadoVerificacion : EstadoVerificacion (1, 1);
        }
        
        operations {
            public new::New (p_nombreCompleto : String, p_email : String, p_password : Password, p_esAdmin : Boolean, p_estadoVerificacion : EstadoVerificacion) : Object->Usuario;
            public destroy::Destroy (p_oid : OID -> Usuario) : Void;
            public modify::Modifier (p_oid : OID -> Usuario, p_nombreCompleto : String, p_email : String, p_password : Password, p_esAdmin : Boolean, p_estadoVerificacion : EstadoVerificacion) : Void;
            public readOID::ReadOID (p_oid : OID -> Usuario) : Object->Usuario;
            public readAll::ReadAll () : List<Object->Usuario>;
            public login::Login (p_email : String, p_password : Password) : String;
            public verificarDni::Custom (p_oid : OID -> Usuario, p_dni : String) : Void;
        }
    };

    Class Vehiculo {
        attributes {
            private oid id : Autogenerated (1, 1);
            private marcaModelo : String (1, 1);
            private matricula : String (1, 1);
            private informacionAdicional : String (0, 1);
        }
        
        operations {
            public new::New (p_marcaModelo : String, p_matricula : String, p_informacionAdicional : String, p_propietario_oid : OID -> Usuario) : Object->Vehiculo;
            public destroy::Destroy (p_oid : OID -> Vehiculo) : Void;
            public modify::Modifier (p_oid : OID -> Vehiculo, p_marcaModelo : String, p_matricula : String) : Void;
            public readOID::ReadOID (p_oid : OID -> Vehiculo) : Object->Vehiculo;
            public readAll::ReadAll () : List<Object->Vehiculo>;
        }
    };

    Class Viaje <AggregateRoot> {
        attributes {
            private oid id : Autogenerated (1, 1);
            private origen : Ubicacion (1, 1);
            private destino : Ubicacion (1, 1);
            private fechaHoraSalida : TimeStamp (1, 1);
            private numPlazasDisponibles : Integer (1, 1);
            private precio : Dinero (1, 1);
            private permiteMascotas : Boolean (1, 1);
            private permiteEquipaje : Boolean (1, 1);
            private observaciones : String (0, 1);
            private estado : EstadoViaje (1, 1);
        }
        
        operations {
            public new::New (p_origen : Ubicacion, p_destino : Ubicacion, p_fechaHoraSalida : TimeStamp, p_numPlazasDisponibles : Integer, p_precio : Dinero, p_permiteMascotas : Boolean, p_permiteEquipaje : Boolean, p_estado : EstadoViaje, p_conductor_oid : OID -> Usuario) : Object->Viaje;
            public destroy::Destroy (p_oid : OID -> Viaje) : Void;
            public modify::Modifier (p_oid : OID -> Viaje, p_origen : Ubicacion, p_destino : Ubicacion, p_fechaHoraSalida : TimeStamp, p_numPlazasDisponibles : Integer, p_precio : Dinero, p_permiteMascotas : Boolean, p_permiteEquipaje : Boolean, p_estado : EstadoViaje) : Void;
            public readOID::ReadOID (p_oid : OID -> Viaje) : Object->Viaje;
            public readAll::ReadAll () : List<Object->Viaje>;
            public gestionarPlazas::Custom (p_oid : OID -> Viaje, p_nuevasPlazas : Integer) : Void;
            public geolocalizarTrayecto::Custom (p_oid : OID -> Viaje) : Void;
            public addPasajero::Relationer -> UsuarioPasajero.pasajero (p_oid : OID -> Viaje, p_usuario_oids : List<OID -> Usuario>) : Void;
            public removePasajero::Relationer -> UsuarioPasajero.pasajero (p_oid : OID -> Viaje, p_usuario_oids : List<OID -> Usuario>) : Void;
        }
    };

    Class Reserva <AggregateMember: Viaje> {
        attributes {
            private oid id : Autogenerated (1, 1);
            private numPlazasReservadas : Integer (1, 1);
            private estado : EstadoReserva (1, 1);
            private fechaSolicitud : TimeStamp (1, 1);
        }
        
        operations {
            public new::New (p_numPlazasReservadas : Integer, p_estado : EstadoReserva, p_fechaSolicitud : TimeStamp, p_viaje_oid : OID -> Viaje, p_pasajero_oid : OID -> Usuario) : Object->Reserva;
            public destroy::Destroy (p_oid : OID -> Reserva) : Void;
            public modify::Modifier (p_oid : OID -> Reserva, p_numPlazasReservadas : Integer, p_estado : EstadoReserva, p_fechaSolicitud : TimeStamp) : Void;
            public readOID::ReadOID (p_oid : OID -> Reserva) : Object->Reserva;
            public readAll::ReadAll () : List<Object->Reserva>;
            public aceptarPasajero::Custom (p_oid : OID -> Reserva) : Void;
        }
    };

    Class Pago {
        attributes {
            private oid id : Autogenerated (1, 1);
            private monto : Dinero (1, 1);
            private fechaPago : TimeStamp (1, 1);
            private estado : EstadoPago (1, 1);
        }
        
        operations {
            public new::New (p_monto : Dinero, p_fechaPago : TimeStamp, p_estado : EstadoPago, p_reserva_oid : OID -> Reserva) : Object->Pago;
            public destroy::Destroy (p_oid : OID -> Pago) : Void;
            public modify::Modifier (p_oid : OID -> Pago, p_monto : Dinero, p_fechaPago : TimeStamp, p_estado : EstadoPago) : Void;
            public readOID::ReadOID (p_oid : OID -> Pago) : Object->Pago;
            public readAll::ReadAll () : List<Object->Pago>;
            public realizarPago::CustomTransaction (p_oid : OID -> Pago) : Void;
            public reembolsarPago::CustomTransaction (p_oid : OID -> Pago) : Void;
        }
    };

    Class Mensaje {
        attributes {
            private oid id : Autogenerated (1, 1);
            private contenido : String (1, 1);
            private fechaHora : TimeStamp (1, 1);
        }
        
        operations {
            public new::New (p_contenido : String, p_fechaHora : TimeStamp, p_viaje_oid : OID -> Viaje, p_remitente_oid : OID -> Usuario) : Object->Mensaje;
            public destroy::Destroy (p_oid : OID -> Mensaje) : Void;
            public modify::Modifier (p_oid : OID -> Mensaje, p_contenido : String, p_fechaHora : TimeStamp) : Void;
            public readOID::ReadOID (p_oid : OID -> Mensaje) : Object->Mensaje;
            public readAll::ReadAll () : List<Object->Mensaje>;
        }
    };

    Class Resena {
        attributes {
            private oid id : Autogenerated (1, 1);
            private puntuacion : Integer (1, 1);
            private comentario : String (0, 1);
            private fechaCreacion : TimeStamp (1, 1);
        }
        
        operations {
            public new::New (p_puntuacion : Integer, p_comentario : String, p_fechaCreacion : TimeStamp, p_viaje_oid : OID -> Viaje, p_autor_oid : OID -> Usuario) : Object->Resena;
            public destroy::Destroy (p_oid : OID -> Resena) : Void;
            public modify::Modifier (p_oid : OID -> Resena, p_puntuacion : Integer, p_fechaCreacion : TimeStamp) : Void;
            public readOID::ReadOID (p_oid : OID -> Resena) : Object->Resena;
            public readAll::ReadAll () : List<Object->Resena>;
            public moderarContenido::Custom (p_oid : OID -> Resena) : Void;
        }
    };

    Class Notificacion {
        attributes {
            private oid id : Autogenerated (1, 1);
            private titulo : String (1, 1);
            private texto : String (1, 1);
            private fechaHora : TimeStamp (1, 1);
        }
        
        operations {
            public new::New (p_titulo : String, p_texto : String, p_fechaHora : TimeStamp, p_usuarioNotificado_oid : OID -> Usuario) : Object->Notificacion;
            public destroy::Destroy (p_oid : OID -> Notificacion) : Void;
            public modify::Modifier (p_oid : OID -> Notificacion, p_titulo : String, p_texto : String, p_fechaHora : TimeStamp) : Void;
            public readOID::ReadOID (p_oid : OID -> Notificacion) : Object->Notificacion;
            public readAll::ReadAll () : List<Object->Notificacion>;
        }
    };

    Association UsuarioVehiculo (Usuario - Vehiculo) {
        => navigable vehiculos (0, *);
        <= navigable propietario (1, 1);
    };

    Association UsuarioViaje (Usuario - Viaje) {
        => navigable viajes (0, *);
        <= navigable conductor (1, 1);
    };

    Association UsuarioPasajero (Usuario - Viaje) {
        => navigable viajespasajero (0, *);
        <= navigable pasajero (0, *);
    };

    Association ViajeReserva (Viaje - Reserva) {
        => navigable reservas (0, *);
        <= navigable viaje (1, 1);
    };

    Association UsuarioReserva (Usuario - Reserva) {
        => navigable reservas (0, *);
        <= navigable pasajero (1, 1);
    };

    Association ReservaPago (Reserva - Pago) {
        => navigable pago (0, 1);
        <= navigable reserva (1, 1);
    };

    Association ViajeMensaje (Viaje - Mensaje) {
        => navigable mensajes (0, *);
        <= navigable viaje (1, 1);
    };

    Association UsuarioMensaje (Usuario - Mensaje) {
        => navigable mensajesEnviados (0, *);
        <= navigable remitente (1, 1);
    };

    Association ViajeResena (Viaje - Resena) {
        => navigable resenas (0, *);
        <= navigable viaje (1, 1);
    };

    Association UsuarioResena (Usuario - Resena) {
        => navigable resenasEscritas (0, *);
        <= navigable autor (1, 1);
    };

    Association UsuarioNotificacion (Usuario - Notificacion) {
        => navigable notificaciones (0, *);
        <= navigable usuarioNotificado (1, 1);
    };
}